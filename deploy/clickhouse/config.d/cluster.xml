<clickhouse>
    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>
    <remote_servers>
        <subscriptions>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>clickhouse-1</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>clickhouse-2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </subscriptions>
    </remote_servers>
    <zookeeper>
        <node>
            <host>keeper-1</host>
            <port>9181</port>
        </node>
        <node>
            <host>keeper-2</host>
            <port>9181</port>
        </node>
        <node>
            <host>keeper-3</host>
            <port>9181</port>
        </node>
    </zookeeper>
    <interserver_http_credentials>
        <user from_env="CLICKHOUSE_USER"/>
        <password from_env="CLICKHOUSE_PASSWORD"/>
    </interserver_http_credentials>
</clickhouse>
